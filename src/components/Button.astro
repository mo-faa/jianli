---
interface Props {
  rounded?: boolean;
  class?: string;
}

/**
 * class 必须在这里单独解构出来，不能留在 ...props 里。
 * 否则 {...props} 会先输出一个 class 属性，模板里的 class 又输出第二个，
 * 浏览器只认第一个 —— 按钮会丢掉 btn--ns / btn-chrome / px-5 等全部基础样式，
 * 表现为「图标和文字挤成一团、没有边框和内边距」。这是 HTML 层面的真实缺陷，
 * 不是样式权重问题，无法用 !important 补救。
 */
const { rounded, class: className, ...props } = Astro.props;
---

<span class="btn-shell inline-flex w-fit h-full">
  <button
    {...props}
    class={`btn--ns btn-chrome h-full w-fit text-xl max-h-[50px] px-5 py-2 cursor-pointer ${
      rounded ? "rounded-full" : "rounded-lg"
    } ${className ?? ""}`}
  >
    <slot />
  </button>
</span>
